# Copy to .env (git-ignored) and fill in. Read by docker compose and by config.py.
# Embeddings always use OpenAI, so this key is required.
OPENAI_API_KEY=sk-your-key-here
# Chat (answers and follow-up rewriting) uses Claude by default.
ANTHROPIC_API_KEY=sk-ant-your-key-here
POSTGRES_PASSWORD=choose-a-strong-password
# Folder of PDFs: used instead of --docs-dir, and mounted at /docs by docker compose
DOCS_DIR=/path/to/your/pdfs

# Optional overrides
# POSTGRES_USER=postgres
# POSTGRES_DB=rag
# POSTGRES_HOST=localhost   # the app container sets this to "db" automatically
# POSTGRES_PORT=5432
# DB_URL=postgresql+psycopg://user:pass@host:5432/rag   # takes precedence over POSTGRES_*
# CHAT_PROVIDER=anthropic     # or: openai (then ANTHROPIC_API_KEY is not needed)
# CHAT_MODEL=claude-haiku-4-5 # default per provider; openai default: gpt-4o-mini
# MAX_DOCS=500                # most PDFs one ingest run processes; 0 = no limit
